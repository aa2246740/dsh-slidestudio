        "operationId": "legacyGenerate",
        "summary": "Generate or refine the archived legacy Deck with the selected model",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string"
