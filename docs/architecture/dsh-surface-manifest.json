{
  "schema": "dsh-surface-manifest-v1",
  "capturedFor": "0.2.2-rc.5",
  "compatibleRange": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "node": "^22.19.0 || >=24.9.0"
  },
  "server": {
    "current": [
      {
        "service": "webServer",
        "symbols": ["ctx.webServer.register", "ctx.webServer.port"],
        "status": "keep-thin",
        "owners": ["dsh-slidestudio", "dsh-slides-host"]
      },
      {
        "service": "connection",
        "symbols": ["connection.requestRejection"],
        "status": "keep-thin",
        "owners": ["dsh-slidestudio", "dsh-slides-host"]
      },
      {
        "service": "llm",
        "symbols": ["ctx.llm.listProviders", "ctx.llm.listModels", "ctx.llm.resolveModelInfo", "ctx.llm.stream"],
        "status": "keep-thin",
        "owners": ["dsh-slides-host"]
      },
      {
        "service": "attachments",
        "symbols": ["ctx.attachments.saveImage"],
        "status": "keep-thin",
        "owners": ["dsh-slides-host"]
      },
      {
        "service": "tools",
        "symbols": ["tools.register", "tools.guard", "tools.execute", "tools.restrict"],
        "status": "remove-after-core-loop",
        "owners": ["dsh-slidestudio", "dsh-slides-host"]
      },
      {
        "service": "agents",
        "symbols": ["ctx.agents.create", "ctx.agents.resume", "ctx.agents.get", "ctx.agents.list"],
        "status": "remove-after-core-loop",
        "owners": ["dsh-slidestudio", "dsh-slides-host"]
      },
      {
        "service": "agentPresets",
        "symbols": ["agentPresets.mount", "agentPresets.composedPreset", "agentPresets.register"],
        "status": "remove-after-core-loop",
        "owners": ["dsh-slidestudio", "dsh-slides-host"]
      },
      {
        "service": "profileContext",
        "symbols": ["profileContext.home"],
        "status": "remove-after-core-loop",
        "owners": ["dsh-slidestudio", "dsh-slides-host"]
      },
      {
        "service": "workspaceRegistry",
        "symbols": ["workspaceRegistry"],
        "status": "remove-after-core-loop",
        "owners": ["dsh-slides-host"]
      },
      {
        "service": "sessionQuery",
        "symbols": ["sessionQuery.listSessions"],
        "status": "remove-after-core-loop",
        "owners": ["dsh-slides-host"]
      },
      {
        "service": "sessionProjections",
        "symbols": ["sessionProjections.stateOf"],
        "status": "remove-after-core-loop",
        "owners": ["dsh-slides-host"]
      }
    ],
    "targetThinShell": ["webServer", "connection", "llm", "attachments"]
  },
  "client": {
    "current": [
      {
        "service": "slots",
        "symbols": ["slots.inject", "slots.register"],
        "status": "keep-thin",
        "inject": true
      },
      {
        "service": "layout",
        "symbols": ["layout.selectPanel", "layout.panelInfo", "layout.beginNavigation"],
        "status": "keep-thin"
      },
      {
        "service": "locale",
        "symbols": ["locale.getLocale", "locale.subscribe"],
        "status": "keep-thin"
      },
      {
        "service": "personal",
        "symbols": ["personal.register", "personal.open", "personal.suspend"],
        "status": "remove-after-core-loop"
      },
      {
        "service": "shortcuts",
        "symbols": ["shortcuts.catalog.getSnapshot"],
        "status": "remove-after-core-loop"
      },
      {
        "service": "sessions",
        "symbols": ["sessions.list.getSnapshot", "sessions.list.subscribe"],
        "status": "remove-after-core-loop"
      }
    ],
    "targetThinShell": ["slots", "layout", "locale"]
  },
  "rc5Adaptations": [
    {
      "id": "prompt-presentation-no-tools",
      "note": "system-prompt/assemble 在 0.2.2-rc.5 交给 PromptPresentation，没有 tools。patchProduceAssembly 只在 tools 是数组时过滤，否则不读这个字段，也不写入 tools: undefined。"
    },
    {
      "id": "tools-register-when",
      "note": "步级裁剪改由 tools.register(definition, { when }) 表达。0.2.0-rc.2 的类型只有一个参数，调用用窄类型封装，guard 仍保留。"
    },
    {
      "id": "model-selection-compat",
      "note": "installModelSelection 在 rc.5 只收 agentCtx。实时读写走 agent.model.current/select，rc.2 继续写 selectionRef。首步 reasoningEffort 放进 agentOptions。"
    },
    {
      "id": "self-contained-client-bundle",
      "note": "dsh-slidestudio/tools/client-build.mjs 自行输出 window.__ModuleLoader__.load，INLINE_SAFE 与 0.2.2-rc.5 对齐。构建不再依赖 DSHX_HARNESS。"
    },
    {
      "id": "locale-fallback",
      "note": "locale.active 为空时用中文。zh 与 zh-CN 用中文。en 以及 rc.5 新增的 ja/es/fr/de/ru/pt 回退英文。非中英文菜单只认 settings.trigger 和 aria-keyshortcuts，找不到则超时并通知 oss:dsh-settings-failed。"
    },
    {
      "id": "engines",
      "note": "dsh-slidestudio engines.node 为 ^22.19.0 || >=24.9.0：接受 22.19.0 与 22 的后续补丁，拒绝 23.0.0，接受 24.9.0 及以上。engines.dsh 为 >=0.2.0-rc.2 <0.3.0-0，同时覆盖 0.2.0-rc.2 与 0.2.2-rc.5。"
    }
  ]
}
