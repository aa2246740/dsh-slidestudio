{
  "name": "dsh-slidestudio",
  "version": "0.2.7",
  "description": "DSH SlideStudio — AI presentations with editable PPTX export for DeepSeek Harness",
  "type": "module",
  "main": "lib/dsh-slidestudio.js",
  "types": "lib/types/dsh-slidestudio.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:client": "node --test scripts/test-settings.mjs scripts/test-data-directory.mjs scripts/test-sidecar-ready.mjs scripts/test-session-entry.mjs",
    "test": "vitest run --config ../vitest.config.mjs --project plugin",
    "test:list": "vitest list --config ../vitest.config.mjs --project plugin"
  },
  "exports": {
    ".": {
      "types": "./lib/types/dsh-slidestudio.d.ts",
      "default": "./lib/dsh-slidestudio.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@open-slidestudio/dsh-slides-host": "link:../packages/dsh-slides-host"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "dsh-personal": ">=0.2.8 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "dsh-personal": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-slidestudio.git"
  },
  "homepage": "https://github.com/aa2246740/dsh-slidestudio#readme",
  "bugs": {
    "url": "https://github.com/aa2246740/dsh-slidestudio/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "presentations",
    "pptx",
    "slidestudio"
  ]
}
