{
  "name": "@open-slidestudio/dsh-slides-host",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.6.1",
    "@open-slidestudio/exporter-native": "0.1.0",
    "@open-slidestudio/pptd-v2": "0.1.0",
    "@open-slidestudio/presentation-run": "0.1.0",
    "@open-slidestudio/slides-runtime": "0.1.0",
    "@open-slidestudio/slides-tools": "0.1.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
