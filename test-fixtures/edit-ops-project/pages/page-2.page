pageType: content
layoutId: body
elements:
  - elementId: mst-main-pageno
    inherited:
      scope: master
      ownerId: main
      elementId: pageno
    elementType: text
    bounds:
      - 880
      - 506
      - 60
      - 22
    layoutRole: footer
    content:
      text: "{page}"
      field: pageNumber
      fontSize: 12
      color: "#6B7280"
      align:
        - right
        - middle
  - elementId: lyt-body-header-rule
    inherited:
      scope: layout
      ownerId: body
      elementId: header-rule
    elementType: line
    bounds:
      - 0
      - 56
      - 960
      - 2
    viewBox:
      - 960
      - 2
    points: 0,1 960,1
    border:
      width: 1.5
      color: "#1D4ED8"
  - elementId: lyt-body-logo
    inherited:
      scope: layout
      ownerId: body
      elementId: logo
    elementType: image
    bounds:
      - 24
      - 12
      - 120
      - 40
    src: media/logo-a.png
  - elementId: lyt-body-footer
    inherited:
      scope: layout
      ownerId: body
      elementId: footer
    elementType: text
    bounds:
      - 40
      - 506
      - 600
      - 22
    layoutRole: footer
    content:
      text: 编辑操作检查 · 正文
      fontSize: 12
      color: "#6B7280"
      align:
        - left
        - middle
  - elementId: title
    elementType: text
    bounds:
      - 40
      - 84
      - 880
      - 56
    content:
      text: 季度成本与毛利
      fontSize: 28
      bold: true
      color: "#111827"
      align:
        - left
        - middle
  - elementId: sales-chart
    elementType: chart
    bounds:
      - 60
      - 150
      - 840
      - 330
    data:
      cols:
        - 季度
        - 成本(万元)
        - 毛利(万元)
      rows:
        - - Q1
          - 800
          - 380
        - - Q2
          - 860
          - 420
        - - Q3
          - 930
          - 460
        - - Q4
          - 1010
          - 510
    series:
      - type: bar
        name: 成本(万元)
        encode:
          x: 季度
          y: 成本(万元)
      - type: bar
        name: 毛利(万元)
        encode:
          x: 季度
          y: 毛利(万元)
    grouping: stacked
    colors:
      - "#1D4ED8"
      - "#F97316"
    legend: true
    labels: true
